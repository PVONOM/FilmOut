<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>FilmOut.App</RootNamespace>
    <AssemblyName>FilmOut</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Application.ThemeMode (the Fluent dark theme) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FilmOut.Core\FilmOut.Core.csproj" />
    <ProjectReference Include="..\FilmOut.Rendering\FilmOut.Rendering.csproj" />
  </ItemGroup>
</Project>
