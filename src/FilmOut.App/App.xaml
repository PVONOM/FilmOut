<Application x:Class="FilmOut.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- A dim interface for a darkened room. The one accent is a darkroom-safelight red,
             used only for run mode, where it matters which state you're in. -->
        <SolidColorBrush x:Key="SafelightBrush" Color="#B4361F"/>
        <SolidColorBrush x:Key="SafelightDeepBrush" Color="#6E2414"/>
        <SolidColorBrush x:Key="QuietTextBrush" Color="#9B958D"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D2A35A"/>
        <SolidColorBrush x:Key="RuleBrush" Color="#3B3734"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,22,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource QuietTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="MaxWidth" Value="760"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <!-- Exposure readouts: tabular figures so numbers don't jitter as they change. -->
        <Style x:Key="Readout" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
    </Application.Resources>
</Application>
